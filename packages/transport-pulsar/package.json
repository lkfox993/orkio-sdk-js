{
    "name": "@orkio/transport-pulsar",
    "version": "0.1.0",
    "description": "Pulsar transport for Orkio SDK",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/orkio/orkio-js.git",
        "directory": "packages/transport-pulsar"
    },
    "type": "module",
    "main": "./dist/index.js",
