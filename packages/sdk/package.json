{
  "name": "@orkio/sdk",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "description": "JavaScript SDK for Orkio",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "clean": "tsc --build --clean",
    "prepublishOnly": "pnpm run build"
  },
  "devDependencies": {
    "@types/form-data": "^2.2.1",
    "@types/node": "^26.4.1"
  },
  "dependencies": {
    "form-data": "^4.0.6"
  }
}
